# Valores de máquina local. A access key "test" é a dummy do LocalStack, não é segredo de produção.
PORT=3000
DATABASE_URL=postgres://wager:wager@localhost:5432/wager
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=domain-events.fifo
SQS_EVENTS_DLQ=domain-events-dlq.fifo
WORKERS_ENABLED=true
OUTBOX_POLL_MS=400
CONSUMER_POLL_MS=400
PENDING_POLL_MS=400
PENDING_REFERENCE_MAX_ATTEMPTS=8
PENDING_REFERENCE_BASE_DELAY_MS=500
OUTBOX_RETRY_BASE_MS=500
SQS_WAIT_SECONDS=1
