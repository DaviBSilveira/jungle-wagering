{
  "name": "jungle-wagering",
  "private": true,
  "version": "1.0.0",
  "description": "Processador de apostas da Jungle. Saldo, ledger e fila no mesmo commit.",
  "scripts": {
    "start": "bun src/main.ts",
    "start:prod": "bun dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "bun test src/domain src/application/canonical.spec.ts",
    "test:unit": "bun test src/domain src/application/canonical.spec.ts",
    "test:integration": "bun test test/integration",
    "test:e2e": "bun test test/e2e/api.test.ts && bun test test/e2e/instances.test.ts",
    "migration:up": "bun src/cli/migrate.ts up",
    "migration:down": "bun src/cli/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.758.0",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.4.16",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "ajv": "8.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.13.10",
    "eslint": "9.22.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1"
  }
}
